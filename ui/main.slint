import { Button, CheckBox, ComboBox, LineEdit, TextEdit, VerticalBox, HorizontalBox, ScrollView } from "std-widgets.slint";

export global ScribletTheme {
    in property <color> surface: #f5f7fa;
    in property <color> surface-raised: #ffffff;
    in property <color> surface-muted: #eef2f6;
    in property <color> text-primary: #17212b;
    in property <color> text-secondary: #607080;
    in property <color> border: #d9e0e7;
    in property <color> accent: #1768b2;
    in property <color> accent-soft: #e8f2fb;
    in property <color> success: #287a4b;
    in property <color> danger: #a83a3a;
}

export struct SnippetRow {
    id: string,
    title: string,
    category: string,
    binding: string,
    preview: string,
    favorite: bool,
    enabled: bool,
}

component NavItem inherits Rectangle {
    in property <string> label;
    in property <bool> selected: false;
    callback activated();
    height: 38px;
    border-radius: 7px;
    background: selected ? ScribletTheme.accent-soft : transparent;

    Text {
        x: 12px;
        vertical-alignment: center;
        text: root.label;
        color: selected ? ScribletTheme.accent : ScribletTheme.text-secondary;
        font-weight: selected ? 700 : 500;
        font-size: 14px;
    }

    TouchArea { clicked => { root.activated(); } }
}

component SectionLabel inherits Text {
    color: ScribletTheme.text-secondary;
    font-size: 11px;
    font-weight: 700;
}

component StatusBadge inherits Rectangle {
    in property <string> label;
    width: 300px;
    height: 32px;
    border-radius: 16px;
    background: ScribletTheme.surface-muted;
    border-width: 1px;
    border-color: ScribletTheme.border;

    HorizontalBox {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 7px;
        Rectangle {
            width: 7px;
            height: 7px;
            border-radius: 4px;
            background: ScribletTheme.accent;
            vertical-stretch: 0;
        }
        Text {
            text: root.label;
            color: ScribletTheme.text-secondary;
            font-size: 11px;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
    }
}

export component AppWindow inherits Window {
    title: "Scriblet";
    width: 1180px;
    height: 720px;
    background: ScribletTheme.surface;

    in-out property <string> selected-id;
    in-out property <string> title-text;
    in-out property <string> category-text;
    in-out property <string> trigger-text;
    in-out property <string> replacement-text;
    in-out property <bool> enabled-value: true;
    in-out property <bool> favorite-value: false;
    in-out property <string> search-text;
    in property <string> active-filter: "All";
    in property <string> status-text: "Ready";
    in property <string> library-count-text: "0 snippets";
    in property <[SnippetRow]> snippet-rows;

    callback save-snippet();
    callback clear-form();
    callback search-library(string);
    callback filter-library(string);
    callback select-snippet(string);
    callback delete-snippet(string);
    callback duplicate-snippet(string);
    callback copy-snippet(string);

    VerticalBox {
        spacing: 0px;

        Rectangle {
            height: 82px;
            background: ScribletTheme.surface-raised;
            HorizontalBox {
                padding-left: 28px;
                padding-right: 28px;
                spacing: 18px;

                VerticalBox {
                    alignment: center;
                    spacing: 2px;
                    Text {
                        text: "Scriblet";
                        color: ScribletTheme.text-primary;
                        font-size: 25px;
                        font-weight: 700;
                    }
                    Text {
                        text: "Your little writing helper";
                        color: ScribletTheme.text-secondary;
                        font-size: 12px;
                    }
                }

                Rectangle { horizontal-stretch: 1; background: transparent; }

                StatusBadge { label: root.status-text; }
                Text {
                    text: root.library-count-text;
                    color: ScribletTheme.text-secondary;
                    font-size: 12px;
                    vertical-alignment: center;
                }
            }
        }

        Rectangle { height: 1px; background: ScribletTheme.border; }

        HorizontalBox {
            spacing: 0px;

            Rectangle {
                width: 210px;
                background: ScribletTheme.surface-raised;
                VerticalBox {
                    padding: 18px;
                    spacing: 7px;

                    SectionLabel { text: "LIBRARY"; }
                    NavItem {
                        label: "All snippets";
                        selected: root.active-filter == "All";
                        activated => { root.filter-library("All"); }
                    }
                    NavItem {
                        label: "★  Favorites";
                        selected: root.active-filter == "Favorites";
                        activated => { root.filter-library("Favorites"); }
                    }

                    Rectangle { height: 10px; background: transparent; }
                    SectionLabel { text: "CATEGORIES"; }
                    NavItem {
                        label: "Clinical";
                        selected: root.active-filter == "Clinical";
                        activated => { root.filter-library("Clinical"); }
                    }
                    NavItem {
                        label: "Administrative";
                        selected: root.active-filter == "Administrative";
                        activated => { root.filter-library("Administrative"); }
                    }
                    NavItem {
                        label: "Signatures";
                        selected: root.active-filter == "Signatures";
                        activated => { root.filter-library("Signatures"); }
                    }
                    NavItem {
                        label: "Personal";
                        selected: root.active-filter == "Personal";
                        activated => { root.filter-library("Personal"); }
                    }

                    Rectangle { vertical-stretch: 1; background: transparent; }
                    Rectangle { height: 1px; background: ScribletTheme.border; }
                    Text {
                        text: "Local first · no telemetry";
                        color: ScribletTheme.text-secondary;
                        font-size: 10px;
                    }
                }
            }

            Rectangle { width: 1px; background: ScribletTheme.border; }

            Rectangle {
                width: 424px;
                background: ScribletTheme.surface;
                VerticalBox {
                    padding: 18px;
                    spacing: 12px;

                    HorizontalBox {
                        spacing: 8px;
                        LineEdit {
                            text <=> root.search-text;
                            placeholder-text: "Search snippets";
                            horizontal-stretch: 1;
                            accepted => { root.search-library(self.text); }
                        }
                        Button {
                            text: "Search";
                            clicked => { root.search-library(root.search-text); }
                        }
                    }

                    Button {
                        text: "+  New snippet";
                        clicked => { root.clear-form(); }
                    }

                    Rectangle {
                        vertical-stretch: 1;
                        background: ScribletTheme.surface-raised;
                        border-width: 1px;
                        border-color: ScribletTheme.border;
                        border-radius: 10px;

                        ScrollView {
                            visible: root.library-count-text != "0 snippets";
                            VerticalLayout {
                                padding: 9px;
                                spacing: 7px;

                                for row in root.snippet-rows : Rectangle {
                                    height: 96px;
                                    border-radius: 8px;
                                    background: root.selected-id == row.id ? ScribletTheme.accent-soft : ScribletTheme.surface-raised;
                                    border-width: 1px;
                                    border-color: root.selected-id == row.id ? ScribletTheme.accent : ScribletTheme.border;

                                    VerticalLayout {
                                        padding: 11px;
                                        spacing: 4px;

                                        HorizontalLayout {
                                            Text {
                                                text: (row.favorite ? "★ " : "") + row.title;
                                                color: ScribletTheme.text-primary;
                                                font-size: 14px;
                                                font-weight: 700;
                                            }
                                            Rectangle { horizontal-stretch: 1; background: transparent; }
                                            Rectangle {
                                                visible: row.binding != "";
                                                height: 23px;
                                                border-radius: 5px;
                                                background: ScribletTheme.accent-soft;
                                                Text {
                                                    x: 7px;
                                                    text: row.binding;
                                                    color: ScribletTheme.accent;
                                                    font-size: 11px;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }

                                        Text {
                                            text: row.category;
                                            color: ScribletTheme.text-secondary;
                                            font-size: 10px;
                                        }
                                        Text {
                                            text: row.preview;
                                            color: ScribletTheme.text-secondary;
                                            font-size: 11px;
                                            overflow: elide;
                                        }
                                    }

                                    TouchArea { clicked => { root.select-snippet(row.id); } }
                                }
                            }
                        }

                        VerticalBox {
                            visible: root.library-count-text == "0 snippets";
                            alignment: center;
                            spacing: 10px;
                            Rectangle { vertical-stretch: 1; background: transparent; }
                            Text {
                                text: "No snippets yet";
                                color: ScribletTheme.text-primary;
                                font-size: 17px;
                                font-weight: 700;
                                horizontal-alignment: center;
                            }
                            Text {
                                text: "Create a phrase once, then reuse it anywhere.";
                                color: ScribletTheme.text-secondary;
                                font-size: 12px;
                                horizontal-alignment: center;
                            }
                            Button {
                                text: "Create your first snippet";
                                clicked => { root.clear-form(); }
                            }
                            Rectangle { vertical-stretch: 1; background: transparent; }
                        }
                    }
                }
            }

            Rectangle { width: 1px; background: ScribletTheme.border; }

            Rectangle {
                horizontal-stretch: 1;
                background: ScribletTheme.surface;
                VerticalBox {
                    padding: 20px;
                    spacing: 12px;

                    HorizontalBox {
                        Text {
                            text: root.selected-id == "" ? "Create snippet" : "Edit snippet";
                            color: ScribletTheme.text-primary;
                            font-size: 20px;
                            font-weight: 700;
                        }
                        Rectangle { horizontal-stretch: 1; background: transparent; }
                        Text {
                            visible: root.selected-id != "";
                            text: "Selected";
                            color: ScribletTheme.text-secondary;
                            font-size: 11px;
                            vertical-alignment: center;
                        }
                    }

                    Text {
                        text: root.selected-id == "" ? "Save a reusable phrase and optionally give it a text binding." : "Update the phrase, category, or binding for this snippet.";
                        color: ScribletTheme.text-secondary;
                        font-size: 12px;
                    }

                    Rectangle {
                        vertical-stretch: 1;
                        background: ScribletTheme.surface-raised;
                        border-width: 1px;
                        border-color: ScribletTheme.border;
                        border-radius: 10px;

                        VerticalBox {
                            padding: 18px;
                            spacing: 9px;

                            SectionLabel { text: "TITLE"; }
                            LineEdit {
                                text <=> root.title-text;
                                placeholder-text: "Prior authorization approval";
                            }

                            SectionLabel { text: "CATEGORY"; }
                            ComboBox {
                                visible: root.selected-id == "";
                                model: ["Clinical", "Administrative", "Signatures", "Personal"];
                                current-index: root.category-text == "Clinical" ? 0 : root.category-text == "Administrative" ? 1 : root.category-text == "Signatures" ? 2 : 3;
                                selected(value) => { root.category-text = value; }
                            }
                            LineEdit {
                                visible: root.selected-id != "";
                                text <=> root.category-text;
                                placeholder-text: "Clinical";
                            }

                            SectionLabel { text: "TEXT BINDING · OPTIONAL"; }
                            LineEdit {
                                text <=> root.trigger-text;
                                placeholder-text: ";p2p";
                            }

                            Text {
                                text: "Type the binding followed by space, Tab, or Enter to expand it.";
                                color: ScribletTheme.text-secondary;
                                font-size: 10px;
                            }

                            SectionLabel { text: "PHRASE"; }
                            TextEdit {
                                text <=> root.replacement-text;
                                vertical-stretch: 1;
                            }

                            Rectangle { height: 1px; background: ScribletTheme.border; }

                            HorizontalBox {
                                spacing: 16px;
                                CheckBox { text: "Enabled"; checked <=> root.enabled-value; }
                                CheckBox { text: "Favorite"; checked <=> root.favorite-value; }
                                Rectangle { horizontal-stretch: 1; background: transparent; }
                            }

                            HorizontalBox {
                                spacing: 8px;
                                Button {
                                    visible: root.selected-id != "";
                                    text: "Copy";
                                    clicked => { root.copy-snippet(root.selected-id); }
                                }
                                Button {
                                    visible: root.selected-id != "";
                                    text: "Duplicate";
                                    clicked => { root.duplicate-snippet(root.selected-id); }
                                }
                                Button {
                                    visible: root.selected-id != "";
                                    text: "Delete";
                                    clicked => { root.delete-snippet(root.selected-id); }
                                }
                                Rectangle { horizontal-stretch: 1; background: transparent; }
                                Button {
                                    text: "Clear";
                                    clicked => { root.clear-form(); }
                                }
                                Button {
                                    text: root.selected-id == "" ? "Create snippet" : "Save changes";
                                    clicked => { root.save-snippet(); }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
