import { Button, CheckBox, ComboBox, LineEdit, TextEdit, VerticalBox, HorizontalBox, ScrollView } from "std-widgets.slint";

export global ScribletTheme {
    in property <color> surface: #f5f7fa;
    in property <color> surface-raised: #ffffff;
    in property <color> surface-muted: #eef2f6;
    in property <color> text-primary: #17212b;
    in property <color> text-secondary: #607080;
    in property <color> border: #d9e0e7;
    in property <color> accent: #1768b2;
    in property <color> accent-soft: #e8f2fb;
    in property <color> success: #287a4b;
    in property <color> warning: #b26a00;
    in property <color> danger: #a83a3a;
}

export struct SnippetRow {
    id: string,
    title: string,
    category: string,
    binding: string,
    preview: string,
    favorite: bool,
    enabled: bool,
    enterprise: bool,
}

component NavItem inherits Rectangle {
    in property <string> label;
    in property <bool> selected: false;
    callback activated();
    height: 34px;
    border-radius: 7px;
    background: selected ? ScribletTheme.accent-soft : transparent;

    Text {
        x: 12px;
        width: parent.width - 24px;
        vertical-alignment: center;
        text: root.label;
        color: selected ? ScribletTheme.accent : ScribletTheme.text-secondary;
        font-weight: selected ? 700 : 500;
        font-size: 13px;
        overflow: elide;
    }

    TouchArea { clicked => { root.activated(); } }
}

component SectionLabel inherits Text {
    color: ScribletTheme.text-secondary;
    font-size: 11px;
    font-weight: 700;
}

component StatusBadge inherits Rectangle {
    in property <string> label;
    in property <color> dot: ScribletTheme.accent;
    height: 32px;
    border-radius: 16px;
    background: ScribletTheme.surface-muted;
    border-width: 1px;
    border-color: ScribletTheme.border;

    HorizontalBox {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 7px;
        Rectangle {
            width: 7px;
            height: 7px;
            border-radius: 4px;
            background: root.dot;
            vertical-stretch: 0;
        }
        Text {
            text: root.label;
            color: ScribletTheme.text-secondary;
            font-size: 11px;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
    }
}

export component AppWindow inherits Window {
    title: "Scriblet";
    preferred-width: 1180px;
    preferred-height: 720px;
    min-width: 1100px;
    min-height: 620px;
    background: ScribletTheme.surface;

    // Editor state
    in-out property <string> selected-id;
    in-out property <string> title-text;
    in-out property <string> category-text;
    // Index of category-text within categories; -1 for a custom category.
    in-out property <int> category-index: -1;
    in-out property <string> trigger-text;
    in-out property <string> replacement-text;
    in-out property <bool> enabled-value: true;
    in-out property <bool> favorite-value: false;
    in-out property <bool> confirm-delete: false;
    in property <bool> read-only: false;

    // Library state
    in-out property <string> search-text;
    in property <string> active-filter: "all";
    in property <[string]> categories;
    in property <[SnippetRow]> snippet-rows;
    in property <string> library-count-text: "0 snippets";

    // Runtime state
    in property <string> status-text: "Ready";
    in property <string> expansion-status-text: "Starting expansion";
    in property <bool> expansion-active: false;
    in property <bool> paused: false;
    in property <bool> enterprise-available: false;
    in property <bool> syncing: false;
    in property <bool> autostart-supported: false;
    in-out property <bool> autostart-enabled: false;
    in property <string> app-version;

    callback save-snippet();
    callback clear-form();
    callback search-library(string);
    callback filter-library(string);
    callback select-snippet(string);
    callback delete-snippet(string);
    callback duplicate-snippet(string);
    callback copy-snippet(string);
    callback toggle-pause();
    callback sync-now();
    callback import-snippets();
    callback export-snippets();
    callback set-autostart(bool);

    VerticalBox {
        spacing: 0px;
        padding: 0px;

        Rectangle {
            height: 82px;
            background: ScribletTheme.surface-raised;
            HorizontalBox {
                padding-left: 28px;
                padding-right: 28px;
                spacing: 18px;

                VerticalBox {
                    alignment: center;
                    spacing: 2px;
                    Text {
                        text: "Scriblet";
                        color: ScribletTheme.text-primary;
                        font-size: 25px;
                        font-weight: 700;
                    }
                    Text {
                        text: "Your little writing helper · v" + root.app-version;
                        color: ScribletTheme.text-secondary;
                        font-size: 12px;
                    }
                }

                Rectangle { horizontal-stretch: 1; background: transparent; }

                StatusBadge {
                    width: 260px;
                    label: root.paused ? "Expansion paused" : root.expansion-status-text;
                    dot: root.paused ? ScribletTheme.warning : (root.expansion-active ? ScribletTheme.success : ScribletTheme.danger);
                }
                StatusBadge {
                    width: 320px;
                    label: root.status-text;
                }
                Text {
                    text: root.library-count-text;
                    color: ScribletTheme.text-secondary;
                    font-size: 12px;
                    vertical-alignment: center;
                }
            }
        }

        Rectangle { height: 1px; background: ScribletTheme.border; }

        HorizontalBox {
            spacing: 0px;
            padding: 0px;

            Rectangle {
                width: 230px;
                background: ScribletTheme.surface-raised;
                VerticalBox {
                    padding: 18px;
                    spacing: 6px;

                    SectionLabel { text: "LIBRARY"; }
                    NavItem {
                        label: "All snippets";
                        selected: root.active-filter == "all";
                        activated => { root.filter-library("all"); }
                    }
                    NavItem {
                        label: "★  Favorites";
                        selected: root.active-filter == "favorites";
                        activated => { root.filter-library("favorites"); }
                    }
                    NavItem {
                        label: "Personal library";
                        selected: root.active-filter == "personal";
                        activated => { root.filter-library("personal"); }
                    }
                    if root.enterprise-available : NavItem {
                        label: "Enterprise library";
                        selected: root.active-filter == "enterprise";
                        activated => { root.filter-library("enterprise"); }
                    }

                    Rectangle { height: 8px; background: transparent; }
                    SectionLabel { text: "CATEGORIES"; }
                    ScrollView {
                        vertical-stretch: 1;
                        VerticalLayout {
                            spacing: 4px;
                            for category in root.categories : NavItem {
                                label: category;
                                selected: root.active-filter == "category:" + category;
                                activated => { root.filter-library("category:" + category); }
                            }
                        }
                    }

                    Rectangle { height: 1px; background: ScribletTheme.border; }
                    SectionLabel { text: "CONTROLS"; }
                    Button {
                        text: root.paused ? "Resume expansion" : "Pause expansion";
                        clicked => { root.toggle-pause(); }
                    }
                    if root.enterprise-available : Button {
                        enabled: !root.syncing;
                        text: root.syncing ? "Syncing…" : "Sync enterprise library";
                        clicked => { root.sync-now(); }
                    }
                    HorizontalBox {
                        padding: 0px;
                        spacing: 6px;
                        Button {
                            text: "Import…";
                            horizontal-stretch: 1;
                            clicked => { root.import-snippets(); }
                        }
                        Button {
                            text: "Export…";
                            horizontal-stretch: 1;
                            clicked => { root.export-snippets(); }
                        }
                    }
                    if root.autostart-supported : CheckBox {
                        text: "Start at login";
                        checked <=> root.autostart-enabled;
                        toggled => { root.set-autostart(self.checked); }
                    }
                    Text {
                        text: "Local first · no telemetry";
                        color: ScribletTheme.text-secondary;
                        font-size: 10px;
                    }
                }
            }

            Rectangle { width: 1px; background: ScribletTheme.border; }

            Rectangle {
                width: 380px;
                background: ScribletTheme.surface;
                VerticalBox {
                    padding: 18px;
                    spacing: 12px;

                    LineEdit {
                        text <=> root.search-text;
                        placeholder-text: "Search snippets";
                        edited(text) => { root.search-library(text); }
                        accepted(text) => { root.search-library(text); }
                    }

                    Button {
                        text: "+  New snippet";
                        clicked => { root.clear-form(); }
                    }

                    Rectangle {
                        vertical-stretch: 1;
                        background: ScribletTheme.surface-raised;
                        border-width: 1px;
                        border-color: ScribletTheme.border;
                        border-radius: 10px;

                        ScrollView {
                            visible: root.snippet-rows.length > 0;
                            VerticalLayout {
                                padding: 9px;
                                spacing: 7px;

                                for row in root.snippet-rows : Rectangle {
                                    height: 96px;
                                    border-radius: 8px;
                                    background: root.selected-id == row.id ? ScribletTheme.accent-soft : ScribletTheme.surface-raised;
                                    border-width: 1px;
                                    border-color: root.selected-id == row.id ? ScribletTheme.accent : ScribletTheme.border;
                                    opacity: row.enabled ? 1.0 : 0.55;

                                    VerticalLayout {
                                        padding: 11px;
                                        spacing: 4px;

                                        HorizontalLayout {
                                            spacing: 6px;
                                            Text {
                                                text: (row.favorite ? "★ " : "") + row.title;
                                                color: ScribletTheme.text-primary;
                                                font-size: 14px;
                                                font-weight: 700;
                                                overflow: elide;
                                                horizontal-stretch: 1;
                                            }
                                            Rectangle {
                                                visible: row.binding != "";
                                                height: 23px;
                                                width: binding-label.preferred-width + 14px;
                                                border-radius: 5px;
                                                background: ScribletTheme.accent-soft;
                                                binding-label := Text {
                                                    x: 7px;
                                                    text: row.binding;
                                                    color: ScribletTheme.accent;
                                                    font-size: 11px;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }

                                        Text {
                                            text: (row.enterprise ? "Enterprise · " : "") + row.category + (row.enabled ? "" : " · disabled");
                                            color: ScribletTheme.text-secondary;
                                            font-size: 10px;
                                        }
                                        Text {
                                            text: row.preview;
                                            color: ScribletTheme.text-secondary;
                                            font-size: 11px;
                                            overflow: elide;
                                        }
                                    }

                                    TouchArea { clicked => { root.select-snippet(row.id); } }
                                }
                            }
                        }

                        VerticalBox {
                            visible: root.snippet-rows.length == 0;
                            alignment: center;
                            spacing: 10px;
                            Rectangle { vertical-stretch: 1; background: transparent; }
                            Text {
                                text: root.search-text == "" && root.active-filter == "all" ? "No snippets yet" : "Nothing matches";
                                color: ScribletTheme.text-primary;
                                font-size: 17px;
                                font-weight: 700;
                                horizontal-alignment: center;
                            }
                            Text {
                                text: root.search-text == "" && root.active-filter == "all" ? "Create a phrase once, then reuse it anywhere." : "Try a different search or filter.";
                                color: ScribletTheme.text-secondary;
                                font-size: 12px;
                                horizontal-alignment: center;
                            }
                            if root.search-text == "" && root.active-filter == "all" : Button {
                                text: "Create your first snippet";
                                clicked => { root.clear-form(); }
                            }
                            Rectangle { vertical-stretch: 1; background: transparent; }
                        }
                    }
                }
            }

            Rectangle { width: 1px; background: ScribletTheme.border; }

            Rectangle {
                horizontal-stretch: 1;
                background: ScribletTheme.surface;
                VerticalBox {
                    padding: 20px;
                    spacing: 12px;

                    HorizontalBox {
                        padding: 0px;
                        Text {
                            text: root.selected-id == "" ? "Create snippet" : (root.read-only ? "View snippet" : "Edit snippet");
                            color: ScribletTheme.text-primary;
                            font-size: 20px;
                            font-weight: 700;
                        }
                        Rectangle { horizontal-stretch: 1; background: transparent; }
                        if root.selected-id != "" : Text {
                            text: root.read-only ? "Enterprise · read-only" : "Selected";
                            color: root.read-only ? ScribletTheme.warning : ScribletTheme.text-secondary;
                            font-size: 11px;
                            vertical-alignment: center;
                        }
                    }

                    Text {
                        text: root.selected-id == "" ? "Save a reusable phrase and optionally give it a text binding." : (root.read-only ? "Enterprise snippets are managed centrally. Duplicate one to make a personal copy." : "Update the phrase, category, or binding for this snippet.");
                        color: ScribletTheme.text-secondary;
                        font-size: 12px;
                        wrap: word-wrap;
                    }

                    Rectangle {
                        vertical-stretch: 1;
                        background: ScribletTheme.surface-raised;
                        border-width: 1px;
                        border-color: ScribletTheme.border;
                        border-radius: 10px;

                        VerticalBox {
                            padding: 18px;
                            spacing: 9px;

                            SectionLabel { text: "TITLE"; }
                            LineEdit {
                                text <=> root.title-text;
                                enabled: !root.read-only;
                                placeholder-text: "Prior authorization approval";
                            }

                            SectionLabel { text: "CATEGORY"; }
                            HorizontalBox {
                                padding: 0px;
                                spacing: 8px;
                                ComboBox {
                                    width: 220px;
                                    enabled: !root.read-only;
                                    model: root.categories;
                                    current-index <=> root.category-index;
                                    selected(value) => { root.category-text = value; }
                                }
                                LineEdit {
                                    text <=> root.category-text;
                                    enabled: !root.read-only;
                                    placeholder-text: "or type a new category";
                                    horizontal-stretch: 1;
                                }
                            }

                            SectionLabel { text: "TEXT BINDING · OPTIONAL"; }
                            LineEdit {
                                text <=> root.trigger-text;
                                enabled: !root.read-only;
                                placeholder-text: ";p2p";
                            }

                            Text {
                                text: "Type the binding followed by space, Tab, or Enter to expand it. Use {{date}}, {{clipboard}}, and {{cursor}} inside the phrase.";
                                color: ScribletTheme.text-secondary;
                                font-size: 10px;
                                wrap: word-wrap;
                            }

                            SectionLabel { text: "PHRASE"; }
                            TextEdit {
                                text <=> root.replacement-text;
                                read-only: root.read-only;
                                vertical-stretch: 1;
                            }

                            Rectangle { height: 1px; background: ScribletTheme.border; }

                            HorizontalBox {
                                padding: 0px;
                                spacing: 16px;
                                CheckBox { text: "Enabled"; enabled: !root.read-only; checked <=> root.enabled-value; }
                                CheckBox { text: "Favorite"; enabled: !root.read-only; checked <=> root.favorite-value; }
                                Rectangle { horizontal-stretch: 1; background: transparent; }
                            }

                            // Snippet actions: one row for the selected snippet, one for the form.
                            if root.selected-id != "" : HorizontalBox {
                                padding: 0px;
                                spacing: 8px;
                                Button {
                                    text: "Copy";
                                    clicked => { root.copy-snippet(root.selected-id); }
                                }
                                Button {
                                    text: "Duplicate";
                                    clicked => { root.duplicate-snippet(root.selected-id); }
                                }
                                if !root.read-only && !root.confirm-delete : Button {
                                    text: "Delete";
                                    clicked => { root.confirm-delete = true; }
                                }
                                if root.confirm-delete : Button {
                                    text: "Confirm delete";
                                    clicked => { root.confirm-delete = false; root.delete-snippet(root.selected-id); }
                                }
                                if root.confirm-delete : Button {
                                    text: "Keep";
                                    clicked => { root.confirm-delete = false; }
                                }
                                Rectangle { horizontal-stretch: 1; background: transparent; }
                            }

                            HorizontalBox {
                                padding: 0px;
                                spacing: 8px;
                                Rectangle { horizontal-stretch: 1; background: transparent; }
                                Button {
                                    text: "Clear";
                                    clicked => { root.clear-form(); }
                                }
                                Button {
                                    enabled: !root.read-only;
                                    primary: true;
                                    text: root.selected-id == "" ? "Create snippet" : "Save changes";
                                    clicked => { root.save-snippet(); }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
